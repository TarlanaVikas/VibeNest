# Server
PORT=5000

# Database
MONGO_URI=your-mongodb-connection-string
# Optional DNS resolvers for MongoDB SRV lookups
# MONGO_DNS_SERVERS=1.1.1.1,1.0.0.1

# Auth
JWT_SECRET=a-long-random-string

# ML inference endpoints used by the journal routes
EMOTION_API_URL=https://your-emotion-model-endpoint
MENTAL_API_URL=https://your-mental-health-model-endpoint
